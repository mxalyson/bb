# ==============================================================================
# LIVE BOT CONFIGURATION
# ==============================================================================
# Copy this file to .env and fill with your values

# Trading Configuration
SYMBOL=BTCUSDT
TIMEFRAME=15
MODEL_PATH=ml_model_master_scalper_365d.pkl

# Risk Management
MIN_ML_CONFIDENCE=0.25
RISK_PER_TRADE_PCT=0.75
INITIAL_CAPITAL=125.0

# Stop Loss / Take Profit
SL_ATR_MULT=2.0
TP_ATR_MULT=0.7

# Trade Management
TRADE_COOLDOWN_SEC=900

# Bot Mode
DRY_RUN=true

# Bybit API Configuration
BYBIT_TESTNET=true
BYBIT_API_KEY=your_api_key_here
BYBIT_API_SECRET=your_api_secret_here

# Telegram Notifications (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ==============================================================================
# NOTES:
# ==============================================================================
#
# DRY_RUN:
#   - true  = Paper trading (no real money)
#   - false = Live trading (REAL MONEY!)
#
# BYBIT_TESTNET:
#   - true  = Use testnet (for testing)
#   - false = Use mainnet (REAL TRADING!)
#
# MIN_ML_CONFIDENCE:
#   - Minimum confidence to open trade (0.0 to 1.0)
#   - Lower = more trades, higher = fewer but higher quality
#   - Recommended: 0.25 to 0.40
#
# RISK_PER_TRADE_PCT:
#   - Risk per trade as % of capital
#   - Recommended: 0.5 to 1.0
#
# SL_ATR_MULT / TP_ATR_MULT:
#   - Stop loss and take profit as multiples of ATR
#   - Current optimized: SL=2.0, TP=0.7
#
# TRADE_COOLDOWN_SEC:
#   - Minimum seconds between trades
#   - 900 = 15 minutes
#
# ==============================================================================
