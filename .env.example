# ============================================================================
# 🤖 LIVE BOT CONFIGURATION - SNIPER MODE
# ============================================================================
# Baseado na análise de otimização do 1.py
# Resultados: 95.8% WR, +17.31% ROI (10 dias), Sharpe 17.85

# ============================================================================
# TRADING PARAMETERS
# ============================================================================

# Symbol to trade
SYMBOL=BTCUSDT

# Timeframe in minutes (15 = 15m candles)
TIMEFRAME=15

# Path to trained model
MODEL_PATH=storage/models/real_btc_ensemble_20251120_234339.pkl

# ============================================================================
# OPTIMIZATION SETTINGS (from backtest)
# ============================================================================

# Minimum ML confidence to take trades (0.0-1.0)
# Recomendação: 0.40 (100% WR, +7.92% ROI - MAIS SELETIVO)
# Alternativas:
#   - 0.25 = Mais trades, 95.8% WR, +17.31% ROI
#   - 0.35 = Menos trades, 97.0% WR, +16.25% ROI
MIN_ML_CONFIDENCE=0.40

# Risk per trade (% of capital)
# Recomendação com 95.8% WR: 0.75-1.25%
RISK_PER_TRADE_PCT=0.75

# Initial capital (USD)
INITIAL_CAPITAL=125.0

# ============================================================================
# STOP LOSS / TAKE PROFIT (ATR multipliers)
# ============================================================================

# Stop Loss multiplier (ATR x)
# Default: 2.0 (tight stop, scalping style)
SL_ATR_MULT=2.0

# Take Profit multiplier (ATR x)
# Default: 1.0 (quick profit taking, TP1 only)
# Nota: TP2/TP3 removidos pois não batem no live
TP_ATR_MULT=1.0

# ============================================================================
# COOLDOWN SETTINGS
# ============================================================================

# Cooldown between trades in seconds
# Default: 1800 (30 minutes - CONSERVADOR)
# Recomendações:
#   - 1800 = 30 min (muito conservador, sniper mode)
#   - 900 = 15 min (previne overtrading)
#   - 600 = 10 min (mais agressivo)
TRADE_COOLDOWN_SEC=1800

# ============================================================================
# EXECUTION MODE
# ============================================================================

# Dry run mode (true/false)
# true = Simula trades sem executar na exchange
# false = Executa trades reais (CUIDADO!)
DRY_RUN=true

# ============================================================================
# TELEGRAM NOTIFICATIONS
# ============================================================================

# Telegram bot token (obtido via @BotFather)
TELEGRAM_BOT_TOKEN=

# Telegram chat ID (seu user ID ou grupo)
# Para descobrir: envie uma mensagem para @userinfobot
TELEGRAM_CHAT_ID=

# ============================================================================
# EXCHANGE API (Bybit)
# ============================================================================

# Bybit API credentials
# Obtenha em: https://www.bybit.com/app/user/api-management
BYBIT_API_KEY=
BYBIT_API_SECRET=

# Testnet (true/false)
# true = Usa testnet.bybit.com (recomendado para testes)
# false = Usa api.bybit.com (LIVE TRADING)
BYBIT_TESTNET=true

# ============================================================================
# ANÁLISE DO BACKTEST (reference)
# ============================================================================
#
# Confiança 25%:
#   - Total Trades: 72
#   - Win Rate: 95.8%
#   - ROI: +17.31% (10 dias)
#   - ROI/year: +631.8%
#   - Sharpe Ratio: 17.85
#   - Max Drawdown: -0.85%
#   - Profit Factor: 7.50
#
# Performance por Faixa:
#   0.00-0.20: 82.1% WR, +2.29% ROI (use MIN_ML_CONFIDENCE >= 0.20 para filtrar)
#   0.20-0.30: 92.9% WR, +2.64% ROI
#   0.30-0.40: 81.8% WR, +0.97% ROI
#   0.40-0.60: 100% WR, +7.92% ROI ⭐
#   0.60-1.00: 100% WR, +2.66% ROI ⭐
#
# Recomendações do 1.py:
#   ✅ Use min_confidence >= 0.25
#   ✅ Switch to MAKER orders (economia: ~$4.72)
#   ✅ Consider increasing risk_per_trade to 1.0-1.25% (WR alto)
#
# ============================================================================
