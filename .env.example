# Trading Bot - Environment Variables Template
# Copie este arquivo para .env e preencha com seus valores reais

# ═══════════════════════════════════════════════════════════════
# BYBIT API (OBRIGATÓRIO)
# ═══════════════════════════════════════════════════════════════
BYBIT_API_KEY=sua_api_key_aqui
BYBIT_API_SECRET=sua_api_secret_aqui
BYBIT_TESTNET=true

# ═══════════════════════════════════════════════════════════════
# TRADING CONFIGURATION
# ═══════════════════════════════════════════════════════════════
SYMBOL=BTCUSDT
TIMEFRAME=15
MODEL_PATH=storage/models/ml_model_master_scalper_365d.pkl

# ═══════════════════════════════════════════════════════════════
# RISK MANAGEMENT
# ═══════════════════════════════════════════════════════════════
MIN_ML_CONFIDENCE=0.40
RISK_PER_TRADE_PCT=0.75
SL_ATR_MULT=1.5
TP_ATR_MULT=1.0
TRADE_COOLDOWN_SEC=900

# ═══════════════════════════════════════════════════════════════
# MODE
# ═══════════════════════════════════════════════════════════════
DRY_RUN=true
INITIAL_CAPITAL=125.0

# ═══════════════════════════════════════════════════════════════
# TELEGRAM (OPCIONAL)
# ═══════════════════════════════════════════════════════════════
TELEGRAM_BOT_TOKEN=seu_token_do_botfather_aqui
TELEGRAM_CHAT_ID=seu_chat_id_aqui

# ═══════════════════════════════════════════════════════════════
# INSTRUÇÕES:
# ═══════════════════════════════════════════════════════════════
# 1. Copie este arquivo: cp .env.example .env
# 2. Preencha .env com seus valores REAIS
# 3. NUNCA faça commit do .env (já está no .gitignore)
# 4. Para deploy (Render/Railway), adicione via interface web!
